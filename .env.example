# ─────────────── REQUIRED ───────────────

# Telegram bot token from @BotFather
BOT_TOKEN=

# api_id / api_hash from https://my.telegram.org/apps
# (needed by the bundled local Telegram Bot API server to raise the
#  file-size limit from 20 MB to 2 GB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your Immich server base URL ending in /api.
# Examples:
#   http://immich-server:2283/api          (same docker network)
#   https://photos.example.com/api         (reverse-proxied)
IMMICH_URL=http://immich-server:2283/api

# Immich API key — generate in Account Settings → API Keys
IMMICH_API_KEY=

# Comma-separated whitelist of Telegram user IDs allowed to use the bot.
# Find your own ID by messaging @userinfobot.
ALLOWED_USER_IDS=

# ─────────────── OPTIONAL ───────────────

# If set, every uploaded asset is added to this album (created if missing).
# Leave empty to upload to the main library only.
ALBUM_NAME=Telegram Inbox

# Hard limits for archive processing (zip/rar/7z/tar)
MAX_ARCHIVE_MB=2000
MAX_ARCHIVE_FILES=1000

# Logging
LOG_LEVEL=INFO
